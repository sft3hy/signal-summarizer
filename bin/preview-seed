#!/usr/bin/env python3
"""Seed a throwaway roll-up so the UI can be seen with content in it.

Writes ONLY to the scratch dir given by SS_DATA_DIR (default: a temp dir chosen
by preview.sh). It never touches the real ~/.signal-summarizer, and it never
calls the voice box — clips are generated locally with ffmpeg, so previewing the
design does not queue work on af_heart or synthesize anyone's chats.

    SS_DATA_DIR=/tmp/ss-preview ./bin/preview-seed
"""

from __future__ import annotations

import json
import os
import shutil
import subprocess
import sys
import time

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))

from app import audio, config, store  # noqa: E402

DAY = time.strftime("%Y-%m-%d")
SELF = "11111111-1111-4111-8111-111111111111"

