def make_clip(path: str, seconds: float, base: float) -> None:
    """A quiet, wavering tone. Stands in for speech so the waveform has shape —
    tremolo gives the amplitude swings the bars read from, without any real voice."""
    if shutil.which("ffmpeg") is None:
        path.write_bytes(b"\x00" * 4096)
        return
    subprocess.run(
        ["ffmpeg", "-hide_banner", "-loglevel", "error", "-y",
         "-f", "lavfi", "-i", f"sine=frequency={int(base)}:duration={seconds}:sample_rate=24000",
         "-af", f"tremolo=f={0.22 + (base % 7) * 0.05}:d=0.85,volume=0.6",
         "-c:a", "libmp3lame", "-b:a", "128k", str(path)],
        check=True, capture_output=True,
    )


def main() -> int:
    if str(config.DATA_DIR).startswith(os.path.expanduser("~/.signal-summarizer")):
        print("refusing to seed the live data dir; point SS_DATA_DIR at a scratch path", file=sys.stderr)
        return 2
    store.init()
    now = int(time.time() * 1000)
    store.set_meta("self_aci", SELF)
    store.set_meta("daemon_version", "0.14.8")

    for i, c in enumerate(CHATS):
        path = audio.chat_path(DAY, c["chat_id"])
        make_clip(str(path), float(c["seconds"]), 180 + i * 60)
        people = json.dumps(c["participants"])
        store.save_rollup(DAY, {
            "chat_id": c["chat_id"], "kind": c["kind"], "title": c["title"],
            "summary": c["summary"], "draft": c["draft"],
            "needs_reply": 1 if c["draft"] else 0,
            "mentioned": c["mentioned"], "mention_labels": c["mention_labels"],
            "msg_count": c["msg_count"], "self_count": c["self_count"],
            "unread": c.get("unread", 0),
            "participants": people,
            "speech_text": c["summary"] + " " + c["draft"],
            "audio_path": str(path), "audio_bytes": path.stat().st_size,
            "audio_seconds": float(c["seconds"]),
            "first_ts": now - 9 * 3600 * 1000, "last_ts": now - (30 + i * 11) * 60 * 1000,
            "model": config.LLM_MODEL, "engine": "llm",
        })
        store.upsert_chat(c["chat_id"], kind=c["kind"], title=c["title"], muted=(i == 3))
        store.touch_chat(c["chat_id"], now)

    intro = audio.intro_path(DAY)
    make_clip(str(intro), 12.0, 120)
    store.save_briefing(DAY, {
        "speech_text": f"Your Signal roll-up for {store.day_of_long(DAY)}.",
        "audio_path": str(intro), "audio_bytes": intro.stat().st_size,
        "audio_seconds": 12.0, "chats": len(CHATS), "voice": config.TTS_VOICE,
    })
    store.start_run(DAY, (now - 24 * 3600 * 1000, now))
    rid = store.last_run()["id"]
    store.finish_run(rid, "ok", chats=len(CHATS),
                     messages=sum(c["msg_count"] for c in CHATS),
                     mentioned=sum(1 for c in CHATS if c["mentioned"]), purged=0,
                     detail="preview seed")
    print(f"seeded {len(CHATS)} chats into {config.DATA_DIR} for {DAY}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
