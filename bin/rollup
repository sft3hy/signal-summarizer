#!/usr/bin/env python3
"""Cron entry point: the 8pm roll-up.

    /app/bin/rollup                 quiet window (last 24h)
    /app/bin/rollup --no-audio    skip af_heart (voice box down or in use)
    /app/bin/rollup --force       re-synthesize audio even if a clip exists
    /app/bin/rollup --hours 6     shorter window, for testing
    /app/bin/rollup --day 2026-10-02   backfill a specific night

Exit code is 0 only when every chat got a summary, so cron logs stay scannable.
"""

from __future__ import annotations

import argparse
import os
import sys
import time

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))

from app import config, rollup, store  # noqa: E402


def main() -> int:
    ap = argparse.ArgumentParser(description="Summarize the last 24 hours of Signal.")
    ap.add_argument("--no-audio", action="store_true", help="do not render MP3s")
    ap.add_argument("--force", action="store_true", help="re-render audio even if cached")
    ap.add_argument("--hours", type=int, default=None, help="window length in hours")
    ap.add_argument("--day", default=None, help="label the roll-up with this YYYY-MM-DD")
    args = ap.parse_args()

    store.init()
    to_ms = int(time.time() * 1000)
    hours = args.hours or config.WINDOW_HOURS
    from_ms = to_ms - hours * 3600 * 1000
    # Only pass an explicit window when it differs from the default; the builder
    # owns the normal case so cron and the button behave identically.
    window = {"from_ms": from_ms, "to_ms": to_ms} if args.hours else {}

    started = time.time()
    print(f"roll-up: window {hours}h ending "
          f"{store.clock_of(to_ms)} {config.TZ}, voice={'off' if args.no_audio else config.TTS_VOICE}", flush=True)

    result = rollup.build(day=args.day, force=args.force, speak=not args.no_audio, **window)

    if result.get("status") == "busy":
        print("roll-up: already running, standing down", flush=True)
        return 0
    if not result.get("ok"):
        print(f"roll-up FAILED: {result.get('error', 'unknown')}", flush=True)
        return 1

    print(
        f"roll-up ok: {result.get('chats', 0)} chats, {result.get('messages', 0)} messages, "
        f"{result.get('mentioned', 0)} with mentions, {result.get('purged', 0)} buffered rows wiped "
        f"in {time.time() - started:.1f}s",
        flush=True,
    )
    for line in (result.get("detail") or []):
        print(f"  note: {line}", flush=True)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
