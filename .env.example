# signal-summarizer — copy to .env, then `chmod 600 .env`
# docker compose reads this file automatically. Never commit it.

# --- required ---------------------------------------------------------------

# Bearer key for omlx. Same key as OMLX_API_KEY in ~/.zshrc.
SS_LLM_API_KEY=

# Basic-auth password for https://signal-summarizer.home.arpa
# Username is `signal` unless you change SS_AUTH_USER. Pin it so your
# phone's saved login survives rebuilds.
SS_AUTH_PASSWORD=

# --- schedule ---------------------------------------------------------------

TZ=America/Los_Angeles
SS_RUN_AT=20:00
SS_WINDOW_HOURS=24

# --- names ------------------------------------------------------------------

SS_DEVICE_NAME=signal-summarizer
SS_AUTH_USER=signal

# The only names that flag a mention on their own. A bare "Sam" never flags.
SS_MENTION_FULL_NAMES=Sam Townsend,Samuel Townsend
# First-name-plus-initial forms are derived from SS_MENTION_FIRSTS + " T".
SS_MENTION_FIRSTS=Sam,Samuel,Samual,Samuell,Sammy
# Nicknames flag a mention alone.
SS_MENTION_NICKNAMES=Slammy,Slammie
# Count a quote-reply to one of your messages as a mention.
SS_MENTION_REPLIES=1

# --- endpoints (defaults are correct for this Studio) ----------------------

SS_SIGNAL_RPC_URL=http://signal-cli:8080
SS_TTS_URL=http://host.docker.internal:8001
SS_TTS_VOICE=af_heart
SS_TTS_SPEED=1.0
SS_LLM_URL=http://100.122.197.81:8000/v1
SS_LLM_MODEL=Qwen3.8-Flash-Next-oQ4e-mtp

# --- knobs ------------------------------------------------------------------

# Raw message text is wiped after every successful roll-up. Set to 1 to keep it
# for same-day drill-down (not recommended: it is a plaintext copy of your chats).
SS_KEEP_RAW=0
# Set to 1 to let anyone on the tailnet read the app without the password.
SS_ALLOW_UNAUTHENTICATED=0
# Set to 1 to stop calling the voice gateway (summaries only, no MP3s).
SS_NO_TTS=0
# Set to 1 to let signal-cli print message bodies to docker logs. Don't.
SIGNAL_VERBOSE=0
